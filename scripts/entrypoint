#!/bin/bash -il

# Use non-interactive cp
unalias cp 2>/dev/null || true

# Create conda user with the same uid as the host, so the container can write
# to mounted volumes.
# Adapted from https://denibertovic.com/posts/handling-permissions-with-docker-volumes/
USER_ID=${HOST_USER_ID:-9001}

# Under rootful Docker/Podman, inner uid 0 maps to outer uid 0
# (e.g. "0 0 4294967296"). Under rootless Podman run with `--userns=keep-id`
# (or `podman unshare`), inner uid 0 maps to the unprivileged host user, so
# we cannot create users, chown system files, or drop privileges.
# See https://github.com/conda-forge/docker-images/issues/280
# and https://github.com/conda-forge/conda-smithy/issues/2731.
#
# /proc/self/uid_map lines are: <inner-start> <outer-start> <length>
ROOTLESS=0
while read -r _ outer_start _; do
    if [ "${outer_start:-0}" != "0" ]; then
        ROOTLESS=1
        break
    fi
done < /proc/self/uid_map

if [ "${ROOTLESS}" = "0" ]; then
    # Rootful path: create a conda user at the host's uid so the container can
    # write to mounted volumes.
    useradd --shell /bin/bash -u $USER_ID -G lucky -o -c "" -m conda
    export HOME=/home/conda
    export USER=conda
    export LOGNAME=conda
    export MAIL=/var/spool/mail/conda
    export supkg="su-exec"
    chown conda:conda $HOME
    cp -R /etc/skel $HOME && chown -R conda:conda $HOME/skel && (ls -A1 $HOME/skel | xargs -I {} mv -n $HOME/skel/{} $HOME) && rm -Rf $HOME/skel
else
    # Rootless path: the container's root is already the host user, so we run
    # as-is instead of creating a user, chowning /home/conda, or dropping
    # privileges with su-exec (all require real root). Mounted volumes are
    # owned by the host user, so they are directly writable.
    #
    # Pre-create /home/conda as a mount point: podman does not create a bind
    # mount's parent the way docker does, so a feedstock mounted at
    # /home/conda/feedstock_root would otherwise fail. The Dockerfile already
    # makes this dir 0777, so we only ensure it exists (idempotent, safe for
    # the unprivileged host user, who cannot chmod root-owned files).
    mkdir -p /home/conda
    export HOME=/home/conda
    export USER=${USER:-root}
    export LOGNAME=${LOGNAME:-root}
    export supkg=""
fi

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/conda/bin

# This is needed to have a predictable channel specification used for builds
# from non-conda-forge channels as conda-smithy does not remove it for us.
rm -f /opt/conda/.condarc

if [ -f /root/.condarc ]; then
    cp /root/.condarc $HOME/.condarc 2>/dev/null || true
fi
cd $HOME 2>/dev/null || true

# Source everything that needs to be.
. /opt/docker/bin/entrypoint_source

# Run whatever the user wants. Under rootful, su-exec drops to the conda
# user; under rootless there is no su-exec, so conda runs as the host user.
exec /opt/conda/bin/${supkg:+$supkg }conda "$@"
