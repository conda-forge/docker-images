#!/bin/bash -il

set -exo pipefail

export python_version="3.14"

# We bootstrap /opt/conda using a `micromamba` binary fetched directly from
# conda-forge (rather than the mamba-org/micromamba-releases GitHub releases),
# since conda-forge is the only place currently publishing micromamba builds
# for riscv64; see https://github.com/conda-forge/conda-forge.github.io/issues/1744
export micromamba_version="2.9.0-0"
if [ "$(uname -m)" = "x86_64" ]; then
   export micromamba_subdir="linux-64"
   export micromamba_chksum="8761c382127e6363bd9e0a2451aa3ef90d071a79133f736e2f759a3bf13040dd"
elif [ "$(uname -m)" = "ppc64le" ]; then
   export micromamba_subdir="linux-ppc64le"
   export micromamba_chksum="23417c79ced152dd6f8e66731e45a77d7058e6af5007eef6fa584f34ce6232b2"
elif [ "$(uname -m)" = "aarch64" ]; then
   export micromamba_subdir="linux-aarch64"
   export micromamba_chksum="e705ffeed90ce0659eb546e4b1e1028c9eaf0bc9cc854867b19ac5ce0ba5852f"
elif [ "$(uname -m)" = "riscv64" ]; then
   export micromamba_subdir="linux-riscv64"
   export micromamba_chksum="ee8f4026b762924cdbafd59036165a6b6138a920d5449d2f84284e310a5ee55d"
else
   exit 1
fi
export micromambapkg="https://conda.anaconda.org/conda-forge/${micromamba_subdir}/micromamba-${micromamba_version}.tar.bz2"

# give sudo permission for conda user to run yum (user creation is postponed
# to the entrypoint, so we can create a user with the same id as the host)
echo 'conda ALL=NOPASSWD: /usr/bin/yum' >> /etc/sudoers
# give sudo permission to copy the cuda headers and libraries for cross compilation
echo 'conda ALL=NOPASSWD: /usr/bin/cp -r /opt/conda/targets/x86_64-linux /usr/local/cuda/targets/x86_64-linux' >> /etc/sudoers
echo 'conda ALL=NOPASSWD: /usr/bin/cp -r /opt/conda/targets/ppc64le-linux /usr/local/cuda/targets/ppc64le-linux' >> /etc/sudoers
echo 'conda ALL=NOPASSWD: /usr/bin/cp -r /opt/conda/targets/sbsa-linux /usr/local/cuda/targets/sbsa-linux' >> /etc/sudoers

# Download micromamba and use it (from outside the target prefix, since
# micromamba refuses to bootstrap a root prefix it is itself living in) to
# create the `base` environment directly at /opt/conda.
curl -s -L $micromambapkg > /tmp/micromamba.tar.bz2
sha256sum /tmp/micromamba.tar.bz2 | grep $micromamba_chksum
mkdir /tmp/micromamba-bootstrap
tar -xjf /tmp/micromamba.tar.bz2 -C /tmp/micromamba-bootstrap bin/micromamba
chmod +x /tmp/micromamba-bootstrap/bin/micromamba

export MAMBA_ROOT_PREFIX=/opt/conda

# Ensure conda build, deployment and docker tools are present
if [ "$(uname -m)" = "riscv64" ]; then
    EXTRA_PKGS=""
else
    EXTRA_PKGS="git"
fi
/tmp/micromamba-bootstrap/bin/micromamba create --yes -n base -c conda-forge \
    python=${python_version} \
    patch \
    pip \
    su-exec \
    pixi \
    tini \
    mamba \
    conda \
    conda-build \
    anaconda-client \
    $EXTRA_PKGS

# Put micromamba itself in condabin, next to the other tools.
mkdir -p /opt/conda/condabin
cp /tmp/micromamba-bootstrap/bin/micromamba /opt/conda/condabin/micromamba
ln -s /opt/conda/condabin/micromamba /opt/conda/bin/micromamba
rm -rf /tmp/micromamba.tar.bz2 /tmp/micromamba-bootstrap

# Work around TLS issues while updating conda's python and retrieving channel notices
export CONDA_NUMBER_CHANNEL_NOTICES="0"
ln -s /opt/conda/etc/profile.d/conda.sh /etc/profile.d/conda.sh
source /opt/conda/etc/profile.d/conda.sh
conda activate
conda config --set show_channel_urls True
conda config --set channel_priority strict
conda config --add channels conda-forge
conda config --show-sources

# Clean to reduce image size
conda clean -tipy

# Install docker tools
export CONDA_SUEXEC_INFO=( `conda list su-exec | grep su-exec` )
echo "su-exec ${CONDA_SUEXEC_INFO[1]}" >> /opt/conda/conda-meta/pinned
export CONDA_TINI_INFO=( `conda list tini | grep tini` )
echo "tini ${CONDA_TINI_INFO[1]}" >> /opt/conda/conda-meta/pinned

# Lucky group gets permission to write in the conda dir
groupadd -g 32766 lucky
chown -R $USER /opt/conda
chgrp -R lucky /opt/conda && chmod -R g=u /opt/conda
